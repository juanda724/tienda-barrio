<?xml version="1.0" encoding="UTF-8"?>
<org.eclipse.epf.uma:TaskDescription xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:org.eclipse.epf.uma="http://www.eclipse.org/epf/uma/1.0.6/uma.ecore" xmlns:epf="http://www.eclipse.org/epf" epf:version="1.5.1" xmi:id="-p-zDNIi322x9cCfeINRxlA" name=",_3Mm4YOIpEfGoE8by5lIpXg" guid="-p-zDNIi322x9cCfeINRxlA" changeDate="2026-11-16T20:55:05.862-0500">
  <mainDescription>&lt;p data-pm-slice=&quot;1 1 []&quot; data-lfile-container=&quot;1339dc23-893e-4198-8279-6321418ae438&quot;>&#xD;
    Para cada requisito (SWR), el ingeniero de QA comprueba que se cumple su criterio de verificación, apoyándose en los&#xD;
    resultados de las pruebas, y registra en el informe si cumple o no y con qué evidencia.&#xD;
&lt;/p></mainDescription>
  <keyConsiderations>&lt;p data-pm-slice=&quot;1 1 []&quot; data-lfile-container=&quot;1339dc23-893e-4198-8279-6321418ae438&quot;>&#xD;
    Un requisito sin evidencia no se da por cumplido. Si no existe una prueba para un requisito, se diseña una antes de&#xD;
    marcarlo.&#xD;
&lt;/p></keyConsiderations>
  <sections xmi:id="_Alaa0OIqEfGoE8by5lIpXg" name="1.  Tomar el criterio de verificación del requisito." guid="_Alaa0OIqEfGoE8by5lIpXg"/>
  <sections xmi:id="_A-RmwOIqEfGoE8by5lIpXg" name="2.  Buscar la prueba o la salida de ejecución que lo respalda." guid="_A-RmwOIqEfGoE8by5lIpXg"/>
  <sections xmi:id="_DLxZEOIqEfGoE8by5lIpXg" name="3.  Registrar en el informe si cumple o no cumple." guid="_DLxZEOIqEfGoE8by5lIpXg"/>
  <purpose>&lt;p data-pm-slice=&quot;1 1 []&quot; data-lfile-container=&quot;1339dc23-893e-4198-8279-6321418ae438&quot;>&#xD;
    Confirmar que el sistema cumple lo que se prometió al cliente.&#xD;
&lt;/p></purpose>
</org.eclipse.epf.uma:TaskDescription>
